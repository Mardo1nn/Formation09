<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="NOVA INSTITUTE - École de formation professionnelle. Développez vos compétences, apprenez un métier, construisez votre avenir.">
    <title>NOVA INSTITUTE - Formation Professionnelle</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://cdn.jsdelivr.net/fontsource/fonts/playfair-display@latest/latin-700.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/fontsource/fonts/inter@latest/latin-400.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/fontsource/fonts/inter@latest/latin-600.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/fontsource/fonts/inter@latest/latin-700.min.css" rel="stylesheet">
    <style>
        /* ============================================
           VARIABLES & RESET
           ============================================ */
        :root {
            --brown-dark: #3E2723;
            --brown-primary: #5D4037;
            --brown-medium: #795548;
            --brown-light: #8D6E63;
            --beige-light: #F5F0E8;
            --beige-cream: #FAF7F2;
            --white: #FFFFFF;
            --gold: #C9A961;
            --gold-light: #D4B876;
            --gold-dark: #A68B4B;
            --text-dark: #2C1810;
            --text-medium: #5D4037;
            --text-light: #8D6E63;
            --shadow-sm: 0 2px 8px rgba(62, 39, 35, 0.08);
            --shadow-md: 0 4px 16px rgba(62, 39, 35, 0.12);
            --shadow-lg: 0 8px 32px rgba(62, 39, 35, 0.16);
            --radius-sm: 8px;
            --radius-md: 12px;
            --radius-lg: 20px;
            --transition: all 0.3s ease;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: 'Inter', sans-serif;
            color: var(--text-dark);
            background: var(--beige-cream);
            line-height: 1.6;
            overflow-x: hidden;
        }

        h1, h2, h3, h4, h5 {
            font-family: 'Playfair Display', serif;
            font-weight: 700;
            line-height: 1.2;
        }

        a {
            text-decoration: none;
            color: inherit;
        }

        img {
            max-width: 100%;
            height: auto;
        }

        button {
            cursor: pointer;
            border: none;
            font-family: inherit;
        }

        input, select, textarea {
            font-family: inherit;
            font-size: 1rem;
        }

        /* ============================================
           BANDEAU ANNONCE
           ============================================ */
        .announcement-bar {
            background: linear-gradient(90deg, var(--brown-dark), var(--brown-primary));
            color: var(--gold-light);
            padding: 10px 0;
            overflow: hidden;
            position: relative;
            font-size: 0.9rem;
            font-weight: 600;
        }

        .announcement-text {
            display: inline-block;
            white-space: nowrap;
            animation: scrollText 30s linear infinite;
            padding-left: 100%;
        }

        @keyframes scrollText {
            0% { transform: translateX(0); }
            100% { transform: translateX(-100%); }
        }

        /* ============================================
           HEADER & NAVIGATION
           ============================================ */
        .header {
            background: var(--white);
            box-shadow: var(--shadow-sm);
            position: sticky;
            top: 0;
            z-index: 1000;
        }

        .nav-container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 1rem 2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .logo-icon {
            width: 50px;
            height: 50px;
            background: linear-gradient(135deg, var(--brown-primary), var(--gold));
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-family: 'Playfair Display', serif;
            font-size: 1.5rem;
            font-weight: 700;
        }

        .logo-text {
            font-family: 'Playfair Display', serif;
            font-size: 1.5rem;
            font-weight: 700;
            color: var(--brown-dark);
        }

        .logo-text span {
            color: var(--gold);
        }

        .nav-menu {
            display: flex;
            list-style: none;
            gap: 2rem;
            align-items: center;
        }

        .nav-menu a {
            color: var(--text-medium);
            font-weight: 600;
            font-size: 0.95rem;
            transition: var(--transition);
            position: relative;
        }

        .nav-menu a:hover {
            color: var(--brown-primary);
        }

        .nav-menu a::after {
            content: '';
            position: absolute;
            bottom: -5px;
            left: 0;
            width: 0;
            height: 2px;
            background: var(--gold);
            transition: var(--transition);
        }

        .nav-menu a:hover::after {
            width: 100%;
        }

        .nav-btn {
            background: linear-gradient(135deg, var(--brown-primary), var(--brown-dark));
            color: white;
            padding: 10px 20px;
            border-radius: var(--radius-sm);
            font-weight: 600;
            transition: var(--transition);
        }

        .nav-btn:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-md);
        }

        .hamburger {
            display: none;
            flex-direction: column;
            gap: 5px;
            cursor: pointer;
            padding: 10px;
        }

        .hamburger span {
            width: 25px;
            height: 3px;
            background: var(--brown-dark);
            border-radius: 2px;
            transition: var(--transition);
        }

        /* ============================================
           HERO SECTION
           ============================================ */
        .hero {
            background: linear-gradient(135deg, var(--brown-dark) 0%, var(--brown-primary) 50%, var(--brown-medium) 100%);
            color: white;
            padding: 6rem 2rem;
            position: relative;
            overflow: hidden;
        }

        .hero::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23C9A961' fill-opacity='0.05'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
            opacity: 0.3;
        }

        .hero-content {
            max-width: 1200px;
            margin: 0 auto;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 4rem;
            align-items: center;
            position: relative;
            z-index: 1;
        }

        .hero-text h1 {
            font-size: 3.5rem;
            margin-bottom: 1rem;
            color: var(--gold-light);
        }

        .hero-text h2 {
            font-size: 1.8rem;
            margin-bottom: 1.5rem;
            font-weight: 400;
            color: var(--beige-light);
        }

        .hero-text p {
            font-size: 1.1rem;
            margin-bottom: 2rem;
            color: var(--beige-light);
            line-height: 1.8;
        }

        .hero-buttons {
            display: flex;
            gap: 1rem;
            flex-wrap: wrap;
        }

        .btn {
            padding: 14px 28px;
            border-radius: var(--radius-sm);
            font-weight: 600;
            font-size: 1rem;
            transition: var(--transition);
            display: inline-block;
            text-align: center;
        }

        .btn-primary {
            background: linear-gradient(135deg, var(--gold), var(--gold-dark));
            color: var(--brown-dark);
        }

        .btn-primary:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 20px rgba(201, 169, 97, 0.4);
        }

        .btn-secondary {
            background: transparent;
            color: white;
            border: 2px solid var(--gold);
        }

        .btn-secondary:hover {
            background: var(--gold);
            color: var(--brown-dark);
        }

        .btn-whatsapp {
            background: #25D366;
            color: white;
        }

        .btn-whatsapp:hover {
            background: #128C7E;
            transform: translateY(-3px);
        }

        .hero-visual {
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .hero-illustration {
            width: 100%;
            max-width: 500px;
            height: 400px;
            background: linear-gradient(135deg, rgba(201, 169, 97, 0.2), rgba(255, 255, 255, 0.1));
            border-radius: var(--radius-lg);
            border: 2px solid rgba(201, 169, 97, 0.3);
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            overflow: hidden;
        }

        .hero-illustration svg {
            width: 80%;
            height: 80%;
        }

        /* ============================================
           SECTIONS GENERALES
           ============================================ */
        .section {
            padding: 5rem 2rem;
            max-width: 1400px;
            margin: 0 auto;
        }

        .section-title {
            text-align: center;
            margin-bottom: 3rem;
        }

        .section-title h2 {
            font-size: 2.5rem;
            color: var(--brown-dark);
            margin-bottom: 1rem;
        }

        .section-title p {
            font-size: 1.1rem;
            color: var(--text-light);
            max-width: 600px;
            margin: 0 auto;
        }

        .section-title .divider {
            width: 80px;
            height: 3px;
            background: var(--gold);
            margin: 1rem auto;
        }

        /* ============================================
           CARTES FORMATIONS
           ============================================ */
        .formations-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
            gap: 2rem;
        }

        .formation-card {
            background: white;
            border-radius: var(--radius-md);
            overflow: hidden;
            box-shadow: var(--shadow-md);
            transition: var(--transition);
        }

        .formation-card:hover {
            transform: translateY(-8px);
            box-shadow: var(--shadow-lg);
        }

        .formation-image {
            height: 220px;
            background: linear-gradient(135deg, var(--brown-light), var(--brown-primary));
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            overflow: hidden;
        }

        .formation-image svg {
            width: 60%;
            height: 60%;
            opacity: 0.9;
        }

        .formation-badge {
            position: absolute;
            top: 15px;
            right: 15px;
            background: var(--gold);
            color: var(--brown-dark);
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 0.85rem;
            font-weight: 600;
        }

        .formation-content {
            padding: 1.5rem;
        }

        .formation-content h3 {
            font-size: 1.4rem;
            color: var(--brown-dark);
            margin-bottom: 0.8rem;
        }

        .formation-content p {
            color: var(--text-medium);
            margin-bottom: 1rem;
            font-size: 0.95rem;
        }

        .formation-info {
            display: flex;
            gap: 1rem;
            margin-bottom: 1rem;
            flex-wrap: wrap;
        }

        .formation-info span {
            display: flex;
            align-items: center;
            gap: 5px;
            font-size: 0.9rem;
            color: var(--text-light);
        }

        .formation-price {
            background: var(--beige-light);
            padding: 1rem;
            border-radius: var(--radius-sm);
            margin-bottom: 1rem;
        }

        .formation-price strong {
            color: var(--brown-dark);
            font-size: 1.2rem;
        }

        .formation-buttons {
            display: flex;
            gap: 0.5rem;
            flex-wrap: wrap;
        }

        .formation-buttons .btn {
            flex: 1;
            padding: 10px 15px;
            font-size: 0.9rem;
            min-width: 100px;
        }

        /* ============================================
           PAGE FORMATION DETAIL
           ============================================ */
        .page {
            display: none;
        }

        .page.active {
            display: block;
        }

        .formation-detail {
            max-width: 1200px;
            margin: 0 auto;
            padding: 3rem 2rem;
        }

        .formation-header {
            background: linear-gradient(135deg, var(--brown-dark), var(--brown-primary));
            color: white;
            padding: 4rem 2rem;
            border-radius: var(--radius-lg);
            margin-bottom: 3rem;
            text-align: center;
        }

        .formation-header h1 {
            font-size: 2.5rem;
            margin-bottom: 1rem;
            color: var(--gold-light);
        }

        .formation-header p {
            font-size: 1.2rem;
            color: var(--beige-light);
            max-width: 700px;
            margin: 0 auto;
        }

        .formation-details-grid {
            display: grid;
            grid-template-columns: 2fr 1fr;
            gap: 3rem;
            margin-bottom: 3rem;
        }

        .formation-main h2 {
            color: var(--brown-dark);
            margin-bottom: 1rem;
            font-size: 1.8rem;
        }

        .formation-main h3 {
            color: var(--brown-primary);
            margin: 2rem 0 1rem;
            font-size: 1.4rem;
        }

        .formation-main ul {
            list-style: none;
            margin-bottom: 1.5rem;
        }

        .formation-main ul li {
            padding: 0.5rem 0;
            padding-left: 2rem;
            position: relative;
            color: var(--text-medium);
        }

        .formation-main ul li::before {
            content: '✓';
            position: absolute;
            left: 0;
            color: var(--gold);
            font-weight: bold;
        }

        .formation-sidebar {
            background: white;
            padding: 2rem;
            border-radius: var(--radius-md);
            box-shadow: var(--shadow-md);
            height: fit-content;
            position: sticky;
            top: 100px;
        }

        .sidebar-price {
            background: var(--beige-light);
            padding: 1.5rem;
            border-radius: var(--radius-sm);
            margin-bottom: 1.5rem;
            text-align: center;
        }

        .sidebar-price .price-label {
            font-size: 0.9rem;
            color: var(--text-light);
            margin-bottom: 0.5rem;
        }

        .sidebar-price .price-value {
            font-size: 2rem;
            font-weight: 700;
            color: var(--brown-dark);
        }

        .sidebar-info {
            margin-bottom: 1.5rem;
        }

        .sidebar-info-item {
            display: flex;
            justify-content: space-between;
            padding: 0.8rem 0;
            border-bottom: 1px solid var(--beige-light);
        }

        .sidebar-info-item:last-child {
            border-bottom: none;
        }

        .sidebar-info-item span:first-child {
            color: var(--text-light);
        }

        .sidebar-info-item span:last-child {
            font-weight: 600;
            color: var(--brown-dark);
        }

        .sidebar-buttons {
            display: flex;
            flex-direction: column;
            gap: 0.8rem;
        }

        .sidebar-buttons .btn {
            width: 100%;
        }

        /* ============================================
           GALERIE
           ============================================ */
        .gallery {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 1rem;
            margin: 2rem 0;
        }

        .gallery-item {
            height: 200px;
            background: linear-gradient(135deg, var(--brown-light), var(--brown-medium));
            border-radius: var(--radius-sm);
            display: flex;
            align-items: center;
            justify-content: center;
            transition: var(--transition);
        }

        .gallery-item:hover {
            transform: scale(1.05);
        }

        .gallery-item svg {
            width: 60%;
            height: 60%;
            opacity: 0.8;
        }

        /* ============================================
           FORMULAIRES
           ============================================ */
        .form-container {
            max-width: 600px;
            margin: 0 auto;
            background: white;
            padding: 3rem;
            border-radius: var(--radius-lg);
            box-shadow: var(--shadow-lg);
        }

        .form-container h2 {
            text-align: center;
            color: var(--brown-dark);
            margin-bottom: 2rem;
            font-size: 2rem;
        }

        .form-group {
            margin-bottom: 1.5rem;
        }

        .form-group label {
            display: block;
            margin-bottom: 0.5rem;
            color: var(--text-medium);
            font-weight: 600;
        }

        .form-group input,
        .form-group select,
        .form-group textarea {
            width: 100%;
            padding: 12px 16px;
            border: 2px solid var(--beige-light);
            border-radius: var(--radius-sm);
            transition: var(--transition);
            background: var(--beige-cream);
        }

        .form-group input:focus,
        .form-group select:focus,
        .form-group textarea:focus {
            outline: none;
            border-color: var(--gold);
            background: white;
        }

        .form-submit {
            width: 100%;
            padding: 14px;
            background: linear-gradient(135deg, var(--brown-primary), var(--brown-dark));
            color: white;
            border: none;
            border-radius: var(--radius-sm);
            font-size: 1.1rem;
            font-weight: 600;
            cursor: pointer;
            transition: var(--transition);
        }

        .form-submit:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-md);
        }

        /* ============================================
           DASHBOARD
           ============================================ */
        .dashboard {
            max-width: 1200px;
            margin: 0 auto;
            padding: 3rem 2rem;
        }

        .dashboard-header {
            background: linear-gradient(135deg, var(--brown-dark), var(--brown-primary));
            color: white;
            padding: 3rem;
            border-radius: var(--radius-lg);
            margin-bottom: 2rem;
        }

        .dashboard-header h1 {
            font-size: 2rem;
            margin-bottom: 0.5rem;
            color: var(--gold-light);
        }

        .dashboard-header p {
            color: var(--beige-light);
        }

        .dashboard-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 1.5rem;
            margin-bottom: 2rem;
        }

        .dashboard-card {
            background: white;
            padding: 1.5rem;
            border-radius: var(--radius-md);
            box-shadow: var(--shadow-sm);
        }

        .dashboard-card h3 {
            color: var(--text-light);
            font-size: 0.9rem;
            margin-bottom: 0.5rem;
            font-family: 'Inter', sans-serif;
        }

        .dashboard-card p {
            color: var(--brown-dark);
            font-size: 1.3rem;
            font-weight: 700;
        }

        .progress-section {
            background: white;
            padding: 2rem;
            border-radius: var(--radius-md);
            box-shadow: var(--shadow-sm);
            margin-bottom: 2rem;
        }

        .progress-section h3 {
            color: var(--brown-dark);
            margin-bottom: 1.5rem;
        }

        .progress-bar {
            background: var(--beige-light);
            height: 30px;
            border-radius: 15px;
            overflow: hidden;
            margin-bottom: 1rem;
        }

        .progress-fill {
            height: 100%;
            background: linear-gradient(90deg, var(--gold), var(--gold-dark));
            border-radius: 15px;
            transition: width 1s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-weight: 600;
        }

        .modules-list {
            list-style: none;
        }

        .modules-list li {
            padding: 1rem;
            border-bottom: 1px solid var(--beige-light);
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .module-check {
            width: 24px;
            height: 24px;
            border-radius: 50%;
            border: 2px solid var(--gold);
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: var(--transition);
        }

        .module-check.completed {
            background: var(--gold);
            color: white;
        }

        .module-check.completed::after {
            content: '✓';
        }

        /* ============================================
           STATISTIQUES
           ============================================ */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 2rem;
            margin: 3rem 0;
        }

        .stat-card {
            background: white;
            padding: 2rem;
            border-radius: var(--radius-md);
            text-align: center;
            box-shadow: var(--shadow-sm);
            transition: var(--transition);
        }

        .stat-card:hover {
            transform: translateY(-5px);
            box-shadow: var(--shadow-md);
        }

        .stat-number {
            font-size: 3rem;
            font-weight: 700;
            color: var(--gold);
            font-family: 'Playfair Display', serif;
        }

        .stat-label {
            color: var(--text-medium);
            font-size: 1rem;
            margin-top: 0.5rem;
        }

        /* ============================================
           PROFESSEURS
           ============================================ */
        .professeurs-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 2rem;
        }

        .professeur-card {
            background: white;
            border-radius: var(--radius-md);
            overflow: hidden;
            box-shadow: var(--shadow-md);
            transition: var(--transition);
        }

        .professeur-card:hover {
            transform: translateY(-5px);
            box-shadow: var(--shadow-lg);
        }

        .professeur-image {
            height: 250px;
            background: linear-gradient(135deg, var(--brown-light), var(--brown-primary));
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .professeur-image svg {
            width: 50%;
            height: 50%;
            opacity: 0.8;
        }

        .professeur-info {
            padding: 1.5rem;
        }

        .professeur-info h3 {
            color: var(--brown-dark);
            margin-bottom: 0.5rem;
        }

        .professeur-info .specialty {
            color: var(--gold);
            font-weight: 600;
            margin-bottom: 1rem;
        }

        .professeur-info p {
            color: var(--text-medium);
            font-size: 0.95rem;
        }

        /* ============================================
           HORAIRES
           ============================================ */
        .horaires-table {
            width: 100%;
            background: white;
            border-radius: var(--radius-md);
            overflow: hidden;
            box-shadow: var(--shadow-md);
        }

        .horaires-table table {
            width: 100%;
            border-collapse: collapse;
        }

        .horaires-table th {
            background: var(--brown-primary);
            color: white;
            padding: 1rem;
            text-align: left;
        }

        .horaires-table td {
            padding: 1rem;
            border-bottom: 1px solid var(--beige-light);
        }

        .horaires-table tr:hover {
            background: var(--beige-cream);
        }

        /* ============================================
           CONTACT
           ============================================ */
        .contact-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 3rem;
